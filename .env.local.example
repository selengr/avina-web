# Copy to .env.local and fill what you need.
# Leave blank values to run with local fallbacks.

# Public API base (menus/news). Empty = use static fallbacks.
NEXT_PUBLIC_HOST_API_KEY=

# Postgres connection string for newsletter/consulting form submissions.
# Works with Neon, Supabase, Vercel Postgres, or any Postgres instance.
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# Used by sitemap.xml and robots.txt in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Needed only to GET saved form submissions.
# Example: GET /api/newsletter?token=your-secret
# Or header: x-submissions-token: your-secret
SUBMISSIONS_READ_TOKEN=
